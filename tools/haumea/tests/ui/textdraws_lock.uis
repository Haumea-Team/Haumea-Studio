# TextDraw mode: a sprite dragged past its own corner mirrors (negative size),
# and a locked textdraw stays put on the canvas and is saved locked.
open "$UI_FIXTURES/ui_map.pwn"
click_item '*' '##editor'
wait 2
click_item '*' 'TextDraws'
wait 5
click_item 'TextDraws' 'Sprite'
wait 5
assert textdraws == 1
assert textdraw.0.size_x == 32
# Off the panel first, so the flipped sprite stays clear of it.
drag_item '*' 'hit' 200 0
wait 5
assert textdraw.0.x > 400
drag_item '*' 'resize' -120 -120
wait 5
assert textdraw.0.size_x < 0
assert textdraw.0.size_y < 0
# The mirrored sprite still takes clicks and drags.
drag_item '*' 'hit' 60 0
wait 5
assert textdraw.0.x > 440
click_item 'TextDraws' 'lock'
wait 5
assert textdraw.0.locked == 1
drag_item '*' 'hit' 100 60
wait 5
assert textdraw.0.x < 480
assert no_item '*' 'resize'
click_item 'TextDraws' 'td_file_options'
wait 3
click_item '*' 'Save As...'
wait 5
click_item 'Save TextDraws As' 'Save'
wait 5
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'locked="true"'
# The game's HUD and SA-MP's chat under the textdraws.
click_item '*' 'Canvas'
wait 3
click_item '*' 'Game HUD'
close_popup
wait 5
assert textdraws == 1
# The Log keeps what was said, the save included.
key Escape
wait 3
click_item '*' 'Windows'
wait 3
click_item '*' 'Review'
wait 3
click_item '*' 'Log'
wait 5
assert item '*' 'Copy'
