# SA-MP's particle effects have their own shelf in the Asset Browser, not the
# Objects one; placed, they are still objects (CreateObject).
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Asset Browser' '##browser_source'
wait 3
click_item '*' 'Objects'
wait 3
click_item 'Asset Browser' '##search_objects'
type "prt_spark"
wait 5
assert no_item 'Asset Browser' '##tile'
click_item 'Asset Browser' '##browser_source'
wait 3
click_item '*' 'Particles'
wait 5
assert item 'Asset Browser' '##tile'
click_item 'Asset Browser' '##tile'
wait 3
click_item 'Asset Browser' 'Place'
wait 3
click_world 2000 -3000 4
wait 5
key Esc
assert objects == 2
shortcut save_map
wait 5
assert pawn_contains "CreateObject(18717,"
