msgid "%s  (%d points)"
msgstr "%s  (%d nokta)"

msgid "%s  model %d"
msgstr "%s  model %d"

msgid "%s (missing)"
msgstr "%s (eksik)"

msgid "%s (you)"
msgstr "%s (siz)"

msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Gözat · %s Harita nesneleri · %s Kaydet · %s Kısayollar"

msgid "%s The update installs the next time Haumea starts."
msgstr "%s Güncelleme Haumea'nın bir sonraki başlatılışında kurulur."

msgid "%s already sits there."
msgstr "%s zaten orada duruyor."

msgid "%s already uses this name."
msgstr "%s zaten bu adı kullanıyor."

msgid "%s drops the selected objects onto the ground."
msgstr "%s seçili nesneleri zemine bırakır."

msgid "%s exists: it is used as it is."
msgstr "%s mevcut: olduğu gibi kullanılır."

msgid "%s follows path \"%s\", which has no points."
msgstr "%s, hiç noktası olmayan \"%s\" yolunu izliyor."

msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s, tek noktalı \"%s\" yolunu izliyor: oraya yürür ve durur."

msgid "%s has no text."
msgstr "%s için metin yok."

msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s pistten %.0f m uzakta: oyunda bunun yerine en yakın pistte, %.1f, %.1f, %.1f konumunda durur."

msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s %d karakter sınırında ve kesilmiş olabilir."

msgid "%s is attached to a target that can't be used by Pawn."
msgstr "%s, Pawn'ın kullanamayacağı bir hedefe bağlı."

msgid "%s is attached to an object that was deleted."
msgstr "%s, silinmiş bir nesneye bağlı."

msgid "%s is loading another map for everyone..."
msgstr "%s herkes için başka bir harita yüklüyor..."

msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
msgstr "%s yalnızca haritada olmayan \"%s\" alanının içinde gösterilecek şekilde ayarlı: alansız yazılır ve her yerde gösterilir."

msgid "%s isn't next to the editor. It ships with every release, and is in the source at https://github.com/itsneufox/Haumea-Studio."
msgstr "%s editörün yanında değil. Her sürümle birlikte gelir ve kaynağı https://github.com/itsneufox/Haumea-Studio adresindedir."

msgid "%s joined the session"
msgstr "%s oturuma katıldı"

msgid "%s left the session"
msgstr "%s oturumdan ayrıldı"

msgid "%s lists every keyboard shortcut; change them in Preferences."
msgstr "%s tüm klavye kısayollarını listeler; bunları Tercihler'den değiştirebilirsiniz."

msgid "%s moves 0 m and doesn't turn, so its MoveObject does nothing."
msgstr "%s 0 m hareket eder ve dönmez, bu yüzden MoveObject hiçbir şey yapmaz."

msgid "%s only shows inside area \"%s\", but they are in different virtual worlds or interiors: no player is ever in both."
msgstr "%s yalnızca \"%s\" alanının içinde gösterilir, ama farklı sanal dünyalarda veya interior'larda: hiçbir oyuncu ikisinde birden bulunmaz."

msgid "%s pastes objects exactly where they were copied."
msgstr "%s nesneleri kopyalandıkları yere tam olarak yapıştırır."

msgid "%s plays %s / %s, which moves only an object's parts: the skin stands still."
msgstr "%s, %s / %s oynatıyor; bu yalnızca nesnenin parçalarını hareket ettirir: skin yerinde durur."

