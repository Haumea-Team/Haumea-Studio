# Haumea Studio, Türkçe (tr).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Türkçe\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Sağ tıkla: Favorilere ekle"

msgid "  (in the map, read-only)"
msgstr "  (haritada, salt okunur)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (max_players değerini karşılaştıracak config.json workspace içinde yok)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " 0.3.7 istemcilerine izin verilir ve bunları görmezler."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " artconfig.txt veya AddSimpleModel içinde olmayan özel ID'ler: "

msgid " IDs: "
msgstr " ID'ler: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\", \"%s\" TXD'sinde (veya üst TXD'lerinde) yok; özgün doku kalır."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\", %d özel modelinin TXD'sinde yok; özgün doku kalır."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" burada yüklü değil. Bu ücretsiz yazı tipinin harf genişlikleri aynı,\n"
"bu yüzden metin oyundaki gibi sığar; harf şekilleri biraz farklıdır."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" burada yüklü değil; önizleme %s kullanıyor. Yazı tipi olmayan oyuncular Windows'un yedek yazı tipini görür."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" geçerli bir Pawn değişken adı değil"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  Model ID %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  malzeme değişiklikleri"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "%.2f m in %.2f s"
msgstr "%.2f m, %.2f saniyede"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f birim | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Yerleştirmek için çift tıkla"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  %d örnek"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, sunucu sınırı olan %d değerini aşıyor; fazlalıklar oluşturulmaz."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "%d NPC yolunda döngü yapıyor veya ileri geri yürüyor: haritanın <prefix>_OnNPCFinishMovePath(npcid, pathid) işlevini gamemode'unuzun OnNPCFinishMovePath içinden çağırın, yoksa yolun sonunda dururlar."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "%d NPC, %d oyuncu yuvası kaplayacak%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d NPC \"%s\" adını taşıyor: adlar benzersiz olmalı, bu yüzden yalnızca biri oluşturulur."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "%d NPC bir aracın aynı koltuğunda (%d) oturuyor: ikisi birden orada oturamaz."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "%d NPC var, ama config.json %d oyuncuya izin veriyor ve her NPC bir oyuncu yuvası kaplıyor."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "%d RemoveBuildingForPlayer çağrısı, oyuncu başına SA-MP sınırı olan %d değerini aşıyor: kalanlar dünyada kalır."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "%d RemoveBuildingForPlayer çağrısı: %d tanesi tüm alanlar için (model -1), %d tanesi tek binalar için."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "%d RemoveBuildingForPlayer satırı o noktada bir GTA binasıyla eşleşmedi."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"%d SA-MP öğesi, %d araç\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d eklendi, %d silindi, %d taşındı, %d döndürüldü, %d malzeme"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "%d eklenmiş veya başvurulmuş nesne temizlikten hariç tutuldu."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "%d ses akışı: oyuncu aynı anda yalnızca birini, en son başlayanı duyar."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "%d çağrı atlandı, çünkü konumları, modelleri veya tutamaçları düz bir değer değil (örneğin bir formül veya koordinat tutan bir değişken)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "%d değiştirilmiş dünya nesnesi RemoveBuildingForPlayer ile oyuncu başına kaldırılacak ve silinmedilerse dışa aktarılan Pawn koduyla yeniden oluşturulacak."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "%d checkpoint ve %d race checkpoint: oyuncu her türden aynı anda yalnızca birini görür, bu yüzden streamer en yakını gösterir."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "%d checkpoint yerel kodla yazılmaz (oyuncunun aynı anda bir checkpoint'i olur ve betik ayarlar). Streamer kodu olarak kaydedin."

msgid "%d corner(s)"
msgstr "%d köşe"

msgid "%d days ago"
msgstr "%d gün önce"

msgid "%d duplicates in %d groups"
msgstr "%d kopya (%d grupta)"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "%d dinamik alan yerel kodla yazılmaz (streamer'a aittir). Streamer kodu olarak kaydedin."

msgid "%d element(s) are in another virtual world or interior"
msgstr "%d öğe başka bir sanal dünyada veya interior'da"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "%d öğe San Andreas haritasının (±%d) ötesinde. Çalışırlar, ancak oyunun suyu, haritası ve radarı orada biter."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "%d öğe SA-MP'nin dünya sınırlarının (±%d) dışında: sunucu bu konumları sınırlar veya yok sayar."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "%d öğe özel model kullanıyor: sunucunun bunları models/artconfig.txt (veya AddSimpleModel) içinde ve artwork etkin%s olarak tanımlaması gerekir; oyuncuların SA-MP 0.3.DL veya bir open.mp istemcisi kullanması gerekir.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d öğe \"%s\" değişken adını paylaşıyor: Pawn kodu derlenmez."

msgid "%d errors"
msgstr "%d hata"

msgid "%d favourites"
msgstr "%d favori"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "Her oyuncu için %d gang zone (%d oyuncu başına, %d genel), bir oyuncunun sahip olabileceği %d sınırını aşıyor; fazlalıklar gösterilmez."

msgid "%d global textdraws, over the limit of %d."
msgstr "%d genel textdraw, %d sınırını aşıyor."

msgid "%d hidden"
msgstr "%d gizli"

msgid "%d in"
msgstr "%d kişi"

msgid "%d in map"
msgstr "Haritada %d"

msgid "%d in the map (read-only)"
msgstr "Haritada %d (salt okunur)"

msgid "%d in, you'd be a %s"
msgstr "%d içeride, %s olurdunuz"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "%d öğe yalnızca dinamik bir alanın içinde gösterilecek şekilde ayarlı, ama yerel kod bunları her yerde gösterir. Streamer kodu olarak kaydedin."

msgid "%d item(s) only inside it"
msgstr "Yalnızca bunun içinde olan %d öğe"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "%d öğe yalnızca kameranın dışında kaldığı bir dinamik alanın içinde gösterilir"

msgid "%d item(s) shown only inside it"
msgstr "%d öğe yalnızca içinde gösterilir"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "%d malzeme, attachment veya interior satırı atlanan nesnelere başvuruyordu."

msgid "%d models | %d instances"
msgstr "%d model | %d örnek"

msgid "%d ms"
msgstr "%d ms"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "%d nesne vurulunca veya çarpılınca patlıyor (object.dat), örneğin variller ve benzin pompaları. Her oyuncu bunları kendi ekranında patlatabilir."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d nesne editörde olmayan modeller (%s) kullanıyor. Başka modlardaki modeller kullanılamaz."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d nesne burada yüklü olmayan \"%s\" yazı tipini kullanıyor: önizleme %s kullanıyor. Oyuncular onu yalnızca yazı tipine sahiplerse görür. Önizlemek için .ttf dosyasını fonts klasörüne koyun (Nesne bilgisi, Yazı tipi klasörünü aç) ve yeniden tarayın."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "Editörün tanımadığı modellere sahip %d nesne harita açılırken dışarıda bırakıldı ve kaydetme bunları siler.%s%s%s%s"

msgid "%d objects"
msgstr "%d nesne"

msgid "%d objects along this path"
msgstr "Bu yol boyunca %d nesne"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "%d nesne görünür / %d oluşturuldu (yerel, sınır 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "%d nesne görünür / %d stream edildi (stream menzilindeki %d içinden, sınır 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d nesne tek bir noktanın %.0f m çevresinde: 0.3.7 istemcisi aynı anda en fazla %d tanesini gösterir, bu yüzden streamer orada bazılarını dışarıda bırakır."

msgid "%d objects, %d x %d cells"
msgstr "%d nesne, %d x %d hücre"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "%d nesne, %d x %d hücre (bazıları ayak izi olmadan)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "%d nesne var, ama CreateObject %d (%s) değerinde durur. Sınırı aşan nesneler oluşturulmaz; bunun yerine Streamer koduyla kaydedin."

msgid "%d of %d"
msgstr "%d / %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "%d / %d nesne (%s): gamemode'un kalanına az yer kaldı."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "Bu modellerden %d tanesi oyunun modloader/Haumea klasörüne aktarıldı; SA-MP oyuncularında bu klasör yok. Bunlar sunucunun models klasöründe özel model olabilir (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "%d oyuncu başına veya stream edilen gang zone: CreatePlayerGangZone yalnızca open.mp'de derlenir ve çalışır, SA-MP 0.3.7 sunucusunda çalışmaz. 0.3.7 için bunları Genel yapın (Nesne bilgisi > Şu olarak gösterilir veya radar art'taki Şu olarak gösterilir ayarı)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "%d oynanabilir yarış haumea_races.inc dosyasına ihtiyaç duyuyor, ama bu dosya workspace'in include'ları arasında yok: o olmadan harita derlenir ama yarışı olmaz. Bir race checkpoint'in ayarları onu oraya kaydedebilir."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "%d oyuncu textdraw'ı, oyuncu başına %d sınırını aşıyor."

msgid "%d points"
msgstr "%d nokta"

msgid "%d selected"
msgstr "%d seçili"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "Seçili %d dünya nesnesi haritada değiştirilecek."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "%d seçili · Taşımak veya döndürmek için gizmoyu sürükle · %s siler."

msgid "%d selected, %d of this kind"
msgstr "%d seçili, bu türden %d"

msgid "%d selected: changes go to all of them."
msgstr "%d seçili: değişiklikler hepsine uygulanır."

msgid "%d shown"
msgstr "%d gösteriliyor"

msgid "%d shown, GTA buildings removed: %d"
msgstr "%d gösteriliyor, kaldırılan GTA binaları: %d"

msgid "%d similar models"
msgstr "%d benzer model"

msgid "%d skins"
msgstr "%d skin"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "Aksanlı veya sembollü %d metin UTF-8 olarak kaydedildi, ama SA-MP ve open.mp istemcileri Windows-1252 çizer, bu yüzden bozuk görünürler (\"ç\" yerine \"Ã§\"). Farklı kaydet > Windows-1252 bunu düzeltir."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "%d textdraw hâlâ haritada, salt okunur: düzenlemek için TextDraw'lar > Ayrı bir dosyaya taşı."

msgid "%d textdraws"
msgstr "%d textdraw"

msgid "%d texture(s)"
msgstr "%d doku"

msgid "%d trailing bytes ignored"
msgstr "%d sondaki bayt yok sayıldı"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "X veya Y ekseninde eğik %d ağaç veya palmiye: oyun bunları rüzgârda sallar ve dik tutar, bu yüzden eğim oyunda görünmez."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "%d araç ID'si (%d tanesi trenler için, her biri 4), %d sınırını aşıyor."

msgid "%d vehicles"
msgstr "%d araç"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "%d araç, %d aktör stream edildi  |  sanal dünya %d, interior %d"

msgid "%d vehicles, over the limit of %d."
msgstr "%d araç, %d sınırını aşıyor."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "Burada gösterilen %d dünya binası bir model -1 kaldırmasının içinde: oyunda kaldırılmış kalırlar."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "Bu dışa aktarma kapsamındaki %d dünya nesnesi değişmedi ve atlanacak. Bir Pawn değişikliği olmasını istiyorsanız taşıyın, döndürün, düzenleyin veya silin."

