"Клик применяет; правый клик оставляет в Избранном."

msgid "%s  (%d points)"
msgstr "%s  (точек: %d)"

msgid "%s  model %d"
msgstr "%s  модель %d"

msgid "%s (missing)"
msgstr "%s (отсутствует)"

msgid "%s (you)"
msgstr "%s (вы)"

msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Обзор · %s Объекты карты · %s Сохранить · %s Горячие клавиши"

msgid "%s The update installs the next time Haumea starts."
msgstr "%s Обновление установится при следующем запуске Haumea."

msgid "%s already sits there."
msgstr "%s уже находится здесь."

msgid "%s already uses this name."
msgstr "%s уже использует это имя."

msgid "%s drops the selected objects onto the ground."
msgstr "%s опускает выбранные объекты на землю."

msgid "%s exists: it is used as it is."
msgstr "%s существует: используется как есть."

msgid "%s follows path \"%s\", which has no points."
msgstr "%s идёт по пути «%s», в котором нет точек."

msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s идёт по пути «%s», в котором одна точка: он идёт туда и останавливается."

msgid "%s has no text."
msgstr "У %s нет текста."

msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s в %.0f m от трека: в игре он встанет на ближайший трек, в точке %.1f, %.1f, %.1f."

msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s достиг лимита в %d символов и мог быть обрезан."

msgid "%s is attached to a target that can't be used by Pawn."
msgstr "%s прикреплён к цели, которую Pawn не может использовать."

msgid "%s is attached to an object that was deleted."
msgstr "%s прикреплён к удалённому объекту."

msgid "%s is loading another map for everyone..."
msgstr "%s загружает другую карту для всех..."

msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
