"Native code, %s text"
msgstr ""
"%s\n"
"Нативный код, кодировка текста: %s"

msgid ""
"%s\n"
"Streamer code, %s text"
msgstr ""
"%s\n"
"Код Streamer, кодировка текста: %s"

