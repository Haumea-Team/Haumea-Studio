"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Экземпляров: %d, элементов SA-MP: %d, транспорта: %d\n"
"%s\n"
"Двойной клик, чтобы поставить"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"Tags: %s\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Экземпляров: %d, элементов SA-MP: %d, транспорта: %d\n"
"Теги: %s\n"
"%s\n"
"Двойной клик, чтобы поставить"

msgid ""
"%s\n"
"Double-click to open it."
msgstr ""
"%s\n"
"Двойной клик, чтобы открыть."

msgid ""
