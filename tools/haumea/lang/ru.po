# Haumea Studio, Русский (ru).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Русский\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Правый клик, чтобы оставить в Избранном"

msgid "  (in the map, read-only)"
msgstr "  (в карте, только чтение)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (в рабочей папке нет config.json, чтобы проверить max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Клиенты 0.3.7 допускаются, но их не увидят."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " Свои ID нет в artconfig.txt и AddSimpleModel: "

msgid " IDs: "
msgstr " ID: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "«%s» нет в TXD «%s» (и его родителях); остаётся исходная текстура."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "«%s» нет в TXD пользовательской модели %d; остаётся исходная текстура."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"«%s» здесь не установлен. Этот свободный шрифт имеет те же ширины букв,\n"
"поэтому текст умещается как в игре; формы букв немного отличаются."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "«%s» здесь не установлен; в предпросмотре используется %s. У игроков без него будет шрифт-замена Windows."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "«%s» не является именем переменной Pawn"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f град.)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID модели %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  переопределение материалов"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f мс"

msgid "%.2f m in %.2f s"
msgstr "%.2f м за %.2f с"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f ед. | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Двойной клик, чтобы поставить"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  экземпляров: %d"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, больше лимита сервера (%d); лишние не создаются."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "NPC: %d. Они ходят по кругу или туда-обратно по пути: вызовите <prefix>_OnNPCFinishMovePath(npcid, pathid) карты из OnNPCFinishMovePath вашего gamemode, иначе они остановятся в конце пути."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "NPC: %d займут слотов игроков: %d%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "Столько NPC (%d) носят имя «%s»: имена должны быть уникальными, поэтому создаётся только один."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "NPC на одном месте (%d) одного транспорта: %d. Они не могут сидеть вместе."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "NPC: %d, но config.json допускает игроков: %d, а каждый NPC занимает слот игрока."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "Вызовов RemoveBuildingForPlayer: %d, больше лимита SA-MP (%d на игрока): остальные остаются в мире."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "Вызовов RemoveBuildingForPlayer: %d, из них %d для целых областей (модель -1) и %d для отдельных зданий."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "Строк RemoveBuildingForPlayer, не совпавших со зданием GTA в этой точке: %d."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"Элементов SA-MP: %d, транспорта: %d\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "добавлено: %d, удалено: %d, перемещено: %d, повёрнуто: %d, материалов: %d"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "Присоединённых или упомянутых объектов, исключённых из очистки: %d."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "Аудиопотоков: %d. Игрок слышит один за раз, последний запущенный."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "Вызовов пропущено: %d, так как позиция, модель или handle не простое значение (например формула или переменная с координатами)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "Изменённых объектов мира: %d. Они будут удалены для каждого игрока через RemoveBuildingForPlayer и воссозданы экспортированным кодом Pawn, если не удалены."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "checkpoint: %d и race checkpoint: %d. Игрок видит по одному каждого типа, поэтому streamer показывает ближайший."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "checkpoint не записаны в нативном коде: %d (у игрока один checkpoint за раз, задаётся скриптом). Сохраните как код Streamer."

msgid "%d corner(s)"
msgstr "Углов: %d"

msgid "%d days ago"
msgstr "%d дн. назад"

msgid "%d duplicates in %d groups"
msgstr "Дубликатов: %d, групп: %d"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "Динамические области не записаны в нативном коде: %d (они принадлежат streamer). Сохраните как код Streamer."

msgid "%d element(s) are in another virtual world or interior"
msgstr "Элементов в другом виртуальном мире или интерьере: %d"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "Элементов за пределами карты San Andreas (±%d): %d. Они работают, но вода, карта и радар игры там заканчиваются."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "Элементов за границами мира SA-MP (±%d): %d. Сервер обрезает или игнорирует эти позиции."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "Элементов с пользовательскими моделями: %d. Серверу нужны они в models/artconfig.txt (или AddSimpleModel) и включённый artwork%s; игрокам нужен SA-MP 0.3.DL или клиент open.mp.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "Элементов с одним именем переменной: %d, имя «%s». Код Pawn не скомпилируется."

msgid "%d errors"
msgstr "Ошибок: %d"

msgid "%d favourites"
msgstr "В избранном: %d"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "gang zone для каждого игрока: %d (%d для игрока, %d глобальных), больше допустимых %d на игрока; лишние не показываются."

msgid "%d global textdraws, over the limit of %d."
msgstr "Глобальных textdraw: %d, больше лимита %d."

msgid "%d hidden"
msgstr "Скрыто: %d"

msgid "%d in"
msgstr "В комнате: %d"

msgid "%d in map"
msgstr "На карте: %d"

msgid "%d in the map (read-only)"
msgstr "На карте: %d (только чтение)"

msgid "%d in, you'd be a %s"
msgstr "В комнате: %d, ваша роль будет: %s"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "Элементов, показываемых только внутри динамической области: %d, но нативный код показывает их везде. Сохраните как код Streamer."

msgid "%d item(s) only inside it"
msgstr "Только внутри неё элементов: %d"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "Элементов, показываемых только внутри динамической области, вне которой камера: %d"

msgid "%d item(s) shown only inside it"
msgstr "Элементов, показываемых только внутри неё: %d"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "Строк материалов, присоединений или интерьеров, ссылавшихся на пропущенные объекты: %d."

msgid "%d models | %d instances"
msgstr "Моделей: %d | экземпляров: %d"

msgid "%d ms"
msgstr "%d мс"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "Объектов, взрывающихся при выстреле или ударе (object.dat), вроде бочек и бензоколонок: %d. Каждый игрок может взорвать их на своём экране."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "Объектов: %d, модели которых редактору неизвестны (%s). Модели из других модов недоступны."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "Объектов: %d, шрифт «%s» здесь не установлен: в предпросмотре используется %s. Игроки увидят его, только если он у них есть. Чтобы увидеть в предпросмотре, положите его .ttf в папку fonts (Свойства объекта, Открыть папку шрифтов) и пересканируйте."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "Объектов с неизвестными редактору моделями, пропущенных при открытии карты: %d. При сохранении они теряются.%s%s%s%s"

msgid "%d objects"
msgstr "Объектов: %d"

msgid "%d objects along this path"
msgstr "Объектов вдоль этого пути: %d"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "Объектов видно: %d / создано: %d (нативно, лимит 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "Объектов видно: %d / в streamer: %d (из %d в зоне стриминга, лимит 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "Объектов: %d в радиусе %.0f m от одной точки. Клиент 0.3.7 показывает не больше %d одновременно, поэтому streamer часть там пропустит."

msgid "%d objects, %d x %d cells"
msgstr "Объектов: %d, ячеек: %d x %d"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "Объектов: %d, ячеек: %d x %d (у некоторых нет контура)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "Объектов: %d, но CreateObject останавливается на %d (%s). Объекты сверх лимита не создаются; сохраните с кодом Streamer."

msgid "%d of %d"
msgstr "%d из %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "Объектов: %d из %d (%s): в остальном gamemode остаётся мало места."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "Моделей из них, импортированных в папку modloader/Haumea игры, которой нет у игроков SA-MP: %d. Они могут стать пользовательскими моделями в папке models сервера (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "gang zone для игрока или стриминговых: %d. CreatePlayerGangZone компилируется и работает только на open.mp, не на сервере SA-MP 0.3.7. Для 0.3.7 сделайте их глобальными (Свойства объекта > Показан как, или «Показан как» в радар-арте)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "Играбельных гонок: %d. Им нужен haumea_races.inc, которого нет в includes рабочей папки: без него карта компилируется, но гонок не будет. Его может сохранить туда настройка race checkpoint."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "Textdraw игрока: %d, больше лимита %d на игрока."

msgid "%d points"
msgstr "Точек: %d"

msgid "%d selected"
msgstr "Выбрано: %d"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "Выбранных объектов мира, которые будут заменены в карте: %d."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "Выбрано: %d · Перетащите гизмо, чтобы переместить или повернуть · %s удаляет."

msgid "%d selected, %d of this kind"
msgstr "Выбрано: %d, этого типа: %d"

msgid "%d selected: changes go to all of them."
msgstr "Выбрано: %d. Изменения применяются ко всем."

msgid "%d shown"
msgstr "Показано: %d"

msgid "%d shown, GTA buildings removed: %d"
msgstr "Показано: %d, зданий GTA удалено: %d"

msgid "%d similar models"
msgstr "Похожих моделей: %d"

msgid "%d skins"
msgstr "Скинов: %d"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "Текстов с акцентами или символами: %d. Они сохраняются в UTF-8, но клиенты SA-MP и open.mp рисуют Windows-1252, поэтому отображаются искажённо («Ã§» вместо «ç»). Исправляет Сохранить как > Windows-1252."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "Textdraw, всё ещё в карте только для чтения: %d. TextDraws > Переместить в отдельный файл, чтобы править их."

msgid "%d textdraws"
msgstr "Textdraw: %d"

msgid "%d texture(s)"
msgstr "Текстур: %d"

msgid "%d trailing bytes ignored"
msgstr "Пропущено лишних байтов в конце: %d"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "Деревьев или пальм, наклонённых по X или Y: %d. Игра качает их на ветру и ставит прямо, поэтому наклон в игре не виден."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "ID транспорта: %d (из них %d для поездов, по 4 каждый), больше лимита %d."

msgid "%d vehicles"
msgstr "Транспортных средств: %d"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "Транспорта: %d, актёров в streamer: %d  |  виртуальный мир %d, интерьер %d"

msgid "%d vehicles, over the limit of %d."
msgstr "Транспорта: %d, больше лимита %d."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "Зданий мира, показанных здесь внутри удаления модели -1: %d. В игре они остаются удалёнными."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "Объектов мира в этой области экспорта без изменений: %d. Они будут пропущены. Переместите, поверните, измените или удалите объект, если он должен стать изменением Pawn."

msgid "%d x %d pixels"
msgstr "%d x %d пикс."

msgid "%d x %d texture, as SA-MP renders it"
msgstr "Текстура %d x %d, как её рисует SA-MP"

msgid "%d zones"
msgstr "Зон: %d"

msgid "%d zones, at most %d around a player"
msgstr "Зон: %d, не более %d вокруг игрока"

