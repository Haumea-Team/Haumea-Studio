# Haumea Studio, Español (es).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Español\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Clic derecho para mantenerlo en Favoritos"

msgid "  (in the map, read-only)"
msgstr "  (en el mapa, solo lectura)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (no hay config.json en el workspace para comprobar max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Los clientes 0.3.7 están permitidos y no los verán."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " IDs personalizados que no están en artconfig.txt ni en AddSimpleModel: "

msgid " IDs: "
msgstr " IDs: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\" no está en el TXD \"%s\" (ni en sus TXD padre); se mantiene la textura original."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\" no está en el TXD del modelo personalizado %d; se mantiene la textura original."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" no está instalada aquí. Esta fuente libre tiene el mismo ancho de letras,\n"
"por lo que el texto encaja como en el juego; la forma de las letras cambia un poco."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" no está instalada aquí; la vista previa usa %s. Los jugadores que no la tengan verán la fuente sustituta de Windows."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" no es un nombre de variable de Pawn válido"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID de modelo %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  material(es) modificado(s)"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "%.2f m in %.2f s"
msgstr "%.2f m en %.2f s"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f unidades | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Doble clic para colocar"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  %d instancias"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, por encima del límite del servidor de %d; las sobrantes no se crean."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "%d NPC hacen un bucle o van y vienen por su ruta: llama a <prefix>_OnNPCFinishMovePath(npcid, pathid) del mapa desde el OnNPCFinishMovePath de tu gamemode, o se detendrán al final de la ruta."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "%d NPC ocuparán %d espacio(s) de jugador%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d NPC se llaman \"%s\": los nombres deben ser únicos, así que solo se crea uno."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "%d NPC ocupan el mismo asiento (%d) de un vehículo: no pueden sentarse los dos ahí."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "%d NPC, pero config.json permite %d jugadores y cada NPC ocupa un espacio de jugador."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "%d llamadas a RemoveBuildingForPlayer, por encima de las %d de SA-MP por jugador: el resto permanece en el mundo."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "%d llamadas a RemoveBuildingForPlayer: %d para áreas completas (modelo -1) y %d para edificios individuales."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "%d línea(s) de RemoveBuildingForPlayer no coincidieron con un edificio de GTA en ese punto."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"%d elemento(s) de SA-MP, %d vehículo(s)\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d añadidos, %d eliminados, %d movidos, %d rotados, %d material"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "%d objetos adjuntos o referenciados excluidos de la limpieza."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "%d streams de audio: un jugador escucha uno a la vez, el último iniciado."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "Se omitieron %d llamada(s) porque su posición, modelo o handle no es un valor simple (por ejemplo una fórmula o una variable que contiene coordenadas)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "%d objeto(s) del mundo modificados se quitarán por jugador con RemoveBuildingForPlayer y el código Pawn exportado los recreará si no se eliminan."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "%d checkpoint(s) y %d race checkpoint(s): un jugador ve uno de cada tipo a la vez, así que el streamer muestra el más cercano."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "%d checkpoint(s) no se escriben en código nativo (un jugador tiene un checkpoint a la vez, definido por el script). Guarda como código Streamer."

msgid "%d corner(s)"
msgstr "%d esquina(s)"

msgid "%d days ago"
msgstr "hace %d días"

msgid "%d duplicates in %d groups"
msgstr "%d duplicados en %d grupos"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "%d área(s) dinámica(s) no se escriben en código nativo (son del streamer). Guarda como código Streamer."

msgid "%d element(s) are in another virtual world or interior"
msgstr "%d elemento(s) están en otro mundo virtual o interior"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "%d elemento(s) fuera del mapa de San Andreas (±%d). Funcionan, pero el agua, el mapa y el radar del juego terminan ahí."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "%d elemento(s) fuera de los límites del mundo de SA-MP (±%d): el servidor ajusta o ignora esas posiciones."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "%d elemento(s) usan modelos personalizados: el servidor los necesita en models/artconfig.txt (o AddSimpleModel) y artwork activado%s; los jugadores necesitan SA-MP 0.3.DL o un cliente de open.mp.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d elementos comparten el nombre de variable \"%s\": el código Pawn no compilará."

msgid "%d errors"
msgstr "%d errores"

msgid "%d favourites"
msgstr "%d favoritos"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "%d gang zones para todos los jugadores (%d por jugador, %d globales), por encima de las %d que puede tener un jugador; las sobrantes no se muestran."

msgid "%d global textdraws, over the limit of %d."
msgstr "%d textdraws globales, por encima del límite de %d."

msgid "%d hidden"
msgstr "%d ocultos"

msgid "%d in"
msgstr "%d en la sala"

msgid "%d in map"
msgstr "%d en el mapa"

msgid "%d in the map (read-only)"
msgstr "%d en el mapa (solo lectura)"

msgid "%d in, you'd be a %s"
msgstr "%d dentro, serías %s"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "%d elemento(s) están configurados para mostrarse solo dentro de un área dinámica, pero el código nativo los muestra en todas partes. Guarda como código Streamer."

msgid "%d item(s) only inside it"
msgstr "%d elemento(s) solo dentro de ella"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "%d elemento(s) solo se muestran dentro de un área dinámica y la cámara está fuera"

msgid "%d item(s) shown only inside it"
msgstr "%d elemento(s) mostrados solo dentro"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "%d línea(s) de material, adjunto o interior hacían referencia a objetos omitidos."

msgid "%d models | %d instances"
msgstr "%d modelos | %d instancias"

msgid "%d ms"
msgstr "%d ms"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "%d objeto(s) explotan al recibir un disparo o golpe (object.dat), como barriles y surtidores de gasolina. Cada jugador puede hacerlos explotar en su propia pantalla."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d objeto(s) usan modelos que el editor no tiene (%s). Los modelos de otros mods no están disponibles."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d objeto(s) usan la fuente \"%s\", que no está instalada aquí: la vista previa usa %s. Los jugadores solo la ven si tienen la fuente. Para previsualizarla, pon su .ttf en la carpeta de fuentes (Información del objeto, Abrir carpeta de fuentes) y vuelve a escanear."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "%d objeto(s) con modelos que el editor no conoce se omitieron al abrir el mapa, y al guardar se descartan.%s%s%s%s"

msgid "%d objects"
msgstr "%d objetos"

msgid "%d objects along this path"
msgstr "%d objetos a lo largo de esta ruta"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "%d objetos visibles / %d creados (nativo, límite 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "%d objetos visibles / %d en streaming (de %d en rango de streaming, límite 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d objetos a menos de %.0f m de un mismo punto: un cliente 0.3.7 muestra como máximo %d a la vez, así que el streamer dejará algunos fuera ahí."

msgid "%d objects, %d x %d cells"
msgstr "%d objetos, %d x %d celdas"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "%d objetos, %d x %d celdas (algunos sin huella)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "%d objetos, pero CreateObject se detiene en %d (%s). Los objetos que pasan del límite no se crean; guarda con código Streamer."

msgid "%d of %d"
msgstr "%d de %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "%d de %d objetos (%s): al resto del gamemode le queda poco margen."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "%d de esos modelos se importaron a la carpeta modloader/Haumea del juego, que los jugadores de SA-MP no tienen. Pueden convertirse en modelos personalizados en la carpeta models del servidor (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "%d gang zone(s) por jugador o en streaming: CreatePlayerGangZone solo compila y funciona en open.mp, no en un servidor SA-MP 0.3.7. Para 0.3.7, configúralas como Globales (Información del objeto > Se muestra como, o el campo Se muestra como del arte de radar)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "%d carrera(s) jugables necesitan haumea_races.inc, que no está en los includes del workspace: sin él el mapa compila pero no tiene carreras. La configuración de un race checkpoint puede guardarlo ahí."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "%d textdraws de jugador, por encima del límite de %d por jugador."

msgid "%d points"
msgstr "%d puntos"

msgid "%d selected"
msgstr "%d seleccionados"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "%d objeto(s) del mundo seleccionados se reemplazarán en el mapa."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "%d seleccionados · Arrastra el gizmo para mover o rotar · %s elimina."

msgid "%d selected, %d of this kind"
msgstr "%d seleccionados, %d de este tipo"

msgid "%d selected: changes go to all of them."
msgstr "%d seleccionados: los cambios se aplican a todos."

msgid "%d shown"
msgstr "%d mostrados"

msgid "%d shown, GTA buildings removed: %d"
msgstr "%d mostrados, edificios de GTA eliminados: %d"

msgid "%d similar models"
msgstr "%d modelos similares"

msgid "%d skins"
msgstr "%d skins"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "%d texto(s) con acentos o símbolos se guardan en UTF-8, pero los clientes de SA-MP y open.mp dibujan Windows-1252, así que se ven corruptos (\"Ã§\" en lugar de \"ç\"). Guardar como > Windows-1252 lo soluciona."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "%d textdraw(s) siguen en el mapa, en solo lectura: TextDraws > Mover a un archivo aparte para editarlos."

msgid "%d textdraws"
msgstr "%d textdraws"

msgid "%d texture(s)"
msgstr "%d textura(s)"

msgid "%d trailing bytes ignored"
msgstr "%d bytes finales ignorados"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "%d árbol(es) o palmera(s) inclinados en X o Y: el juego los mece con el viento y los endereza, así que la inclinación no se ve en el juego."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "%d ids de vehículo (%d de ellos de trenes, 4 cada uno), por encima del límite de %d."

msgid "%d vehicles"
msgstr "%d vehículos"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "%d vehículos, %d actores en streaming  |  mundo virtual %d, interior %d"

msgid "%d vehicles, over the limit of %d."
msgstr "%d vehículos, por encima del límite de %d."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "%d edificio(s) del mundo mostrados aquí están dentro de una eliminación de modelo -1: en el juego permanecen eliminados."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "%d objeto(s) del mundo en este alcance de exportación no han cambiado y se omitirán. Mueve, rota, edita o elimina uno si debe convertirse en un cambio de Pawn."

msgid "%d x %d pixels"
msgstr "%d x %d píxeles"

msgid "%d x %d texture, as SA-MP renders it"
msgstr "Textura de %d x %d, tal como la renderiza SA-MP"

msgid "%d zones"
msgstr "%d zonas"

msgid "%d zones, at most %d around a player"
msgstr "%d zonas, como máximo %d alrededor de un jugador"

msgid ""
"%s\n"
"\n"
"Or in ~/.codex/config.toml:\n"
"%s"
msgstr ""
"%s\n"
"\n"
"O en ~/.codex/config.toml:\n"
"%s"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"%d instancia(s), %d elemento(s) de SA-MP, %d vehículo(s)\n"
"%s\n"
"Doble clic para colocar"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"Tags: %s\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"%d instancia(s), %d elemento(s) de SA-MP, %d vehículo(s)\n"
"Etiquetas: %s\n"
"%s\n"
"Doble clic para colocar"

msgid ""
"%s\n"
"Double-click to open it."
msgstr ""
"%s\n"
"Doble clic para abrirlo."

msgid ""
"%s\n"
"Include it in your gamemode and call %s_CreateTextDraws()\n"
"from OnGameModeInit and %s_ShowTextDraws(playerid)."
msgstr ""
"%s\n"
"Inclúyelo en tu gamemode y llama a %s_CreateTextDraws()\n"
"desde OnGameModeInit y a %s_ShowTextDraws(playerid)."

msgid ""
"%s\n"
"Native code, %s text"
msgstr ""
"%s\n"
"Código nativo, texto %s"

msgid ""
"%s\n"
"Streamer code, %s text"
msgstr ""
"%s\n"
"Código Streamer, texto %s"

msgid ""
"%s\n"
"TXD %s, model %d\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, modelo %d\n"
"Clic para aplicarla; clic derecho para mantenerla en Favoritos."

msgid ""
"%s\n"
"TXD %s, model %d (no model loads this TXD)\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, modelo %d (ningún modelo carga este TXD)\n"
"Clic para aplicarla; clic derecho para mantenerla en Favoritos."

msgid "%s  (%d points)"
msgstr "%s  (%d puntos)"

msgid "%s  model %d"
msgstr "%s  modelo %d"

msgid "%s (missing)"
msgstr "%s (no existe)"

msgid "%s (you)"
msgstr "%s (tú)"

msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Explorar · %s Objetos del mapa · %s Guardar · %s Atajos"

msgid "%s The update installs the next time Haumea starts."
msgstr "%s La actualización se instalará la próxima vez que se inicie Haumea."

msgid "%s already sits there."
msgstr "%s ya ocupa ese asiento."

msgid "%s already uses this name."
msgstr "%s ya usa este nombre."

msgid "%s drops the selected objects onto the ground."
msgstr "%s deja caer los objetos seleccionados al suelo."

msgid "%s exists: it is used as it is."
msgstr "%s existe: se usa tal cual."

msgid "%s follows path \"%s\", which has no points."
msgstr "%s sigue la ruta \"%s\", que no tiene puntos."

msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s sigue la ruta \"%s\", que tiene un punto: camina hasta él y se detiene."

msgid "%s has no text."
msgstr "%s no tiene texto."

msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s está a %.0f m de la vía: en el juego se coloca en la vía más cercana, en %.1f, %.1f, %.1f."

msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s está en el límite de %d caracteres y puede haberse cortado."

msgid "%s is attached to a target that can't be used by Pawn."
msgstr "%s está adjunto a un destino que Pawn no puede usar."

msgid "%s is attached to an object that was deleted."
msgstr "%s está adjunto a un objeto que se eliminó."

msgid "%s is loading another map for everyone..."
msgstr "%s está cargando otro mapa para todos..."

msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
msgstr "%s está configurado para mostrarse solo dentro del área \"%s\", que no está en el mapa: se escribe sin ella y se muestra en todas partes."

msgid "%s isn't next to the editor. It ships with every release, and is in the source at https://github.com/itsneufox/Haumea-Studio."
msgstr "%s no está junto al editor. Se incluye en cada versión y está en el código fuente en https://github.com/itsneufox/Haumea-Studio."

msgid "%s joined the session"
msgstr "%s se unió a la sesión"

msgid "%s left the session"
msgstr "%s salió de la sesión"

msgid "%s lists every keyboard shortcut; change them in Preferences."
msgstr "%s lista todos los atajos de teclado; cámbialos en Preferencias."

msgid "%s moves 0 m and doesn't turn, so its MoveObject does nothing."
msgstr "%s se mueve 0 m y no gira, así que su MoveObject no hace nada."

msgid "%s only shows inside area \"%s\", but they are in different virtual worlds or interiors: no player is ever in both."
msgstr "%s solo se muestra dentro del área \"%s\", pero están en mundos virtuales o interiores distintos: ningún jugador está nunca en ambos."

msgid "%s pastes objects exactly where they were copied."
msgstr "%s pega los objetos exactamente donde se copiaron."

msgid "%s plays %s / %s, which moves only an object's parts: the skin stands still."
msgstr "%s reproduce %s / %s, que solo mueve las partes de un objeto: la skin se queda quieta."

msgid "%s plays %s / %s, which twists the skin out of shape."
msgstr "%s reproduce %s / %s, que deforma la skin."

msgid "%s plays driver recording %s but isn't driving a vehicle: open.mp reports it playing, yet the NPC never moves. Put it in a vehicle as the driver."
msgstr "%s reproduce la grabación de conductor %s pero no conduce un vehículo: open.mp lo da por reproduciéndose, pero el NPC nunca se mueve. Ponlo en un vehículo como conductor."

msgid "%s plays on-foot recording %s while in a vehicle; it needs to be on foot."
msgstr "%s reproduce la grabación a pie %s estando en un vehículo; debe estar a pie."

msgid "%s points the camera at the selection."
msgstr "%s apunta la cámara a la selección."

msgid "%s shares player attachment slot %d with %s."
msgstr "%s comparte el slot de adjunto de jugador %d con %s."

msgid "%s sits in a vehicle that was deleted, so it is saved on foot."
msgstr "%s está en un vehículo que se eliminó, así que se guarda a pie."

msgid "%s uses a player bone attachment, but its target isn't a player or NPC."
msgstr "%s usa un adjunto a hueso de jugador, pero su destino no es un jugador ni un NPC."

msgid "%s walks node file %d, which isn't in the workspace (%s). open.mp downloads it on first use; offline servers need it copied there."
msgstr "%s recorre el archivo de nodos %d, que no está en el workspace (%s). open.mp lo descarga en el primer uso; los servidores sin conexión necesitan copiarlo ahí."

msgid "%s won't be offered again."
msgstr "%s no se ofrecerá de nuevo."

msgid "%s's group has %s, which Windows-1252 (what SA-MP and open.mp clients draw) doesn't have: it is saved as '?'."
msgstr "El grupo de %s tiene %s, que Windows-1252 (lo que dibujan los clientes de SA-MP y open.mp) no tiene: se guarda como '?'."

msgid "%s's material text has %s, which Windows-1252 (what SA-MP and open.mp clients draw) doesn't have: it is saved as '?'."
msgstr "El texto de material de %s tiene %s, que Windows-1252 (lo que dibujan los clientes de SA-MP y open.mp) no tiene: se guarda como '?'."

msgid "%s's note has %s, which Windows-1252 (what SA-MP and open.mp clients draw) doesn't have: it is saved as '?'."
msgstr "La nota de %s tiene %s, que Windows-1252 (lo que dibujan los clientes de SA-MP y open.mp) no tiene: se guarda como '?'."

msgid "%s's text has %s, which Windows-1252 (what SA-MP and open.mp clients draw) doesn't have: it is saved as '?'."
