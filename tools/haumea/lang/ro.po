# Haumea Studio, Română (ro).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Română\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Clic dreapta pentru a păstra în Favorite"

msgid "  (in the map, read-only)"
msgstr "  (în hartă, doar citire)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (nu există config.json în workspace pentru a verifica max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Clienții 0.3.7 sunt permiși și nu le vor vedea."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " ID-uri personalizate care nu sunt în artconfig.txt sau AddSimpleModel: "

msgid " IDs: "
msgstr " ID-uri: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "„%s” nu se află în TXD „%s” (sau în părinții săi); textura originală rămâne."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "„%s” nu se află în TXD-ul modelului personalizat %d; textura originală rămâne."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"„%s” nu este instalat aici. Acest font gratuit are aceeași lățime a literelor,\n"
"deci textul se potrivește ca în joc; formele literelor diferă puțin."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "„%s” nu este instalat aici; previzualizarea folosește %s. Jucătorii fără el primesc fontul de înlocuire din Windows."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "„%s” nu este un nume de variabilă Pawn"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f°)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID model %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  suprascrieri de material"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "%.2f m in %.2f s"
msgstr "%.2f m în %.2f s"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f unități | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Dublu clic pentru a plasa"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  instanțe: %d"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, peste limita serverului de %d; cele în plus nu sunt create."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "NPC-uri cu traseu în buclă sau dus-întors: %d. Apelează <prefix>_OnNPCFinishMovePath(npcid, pathid) al hărții din OnNPCFinishMovePath al gamemode-ului tău, altfel se opresc la capătul traseului."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "NPC-uri care vor ocupa sloturi de jucător: %d, sloturi: %d%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d NPC-uri se numesc „%s”: numele trebuie să fie unice, deci se creează doar unul."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "NPC-uri așezate pe același loc (%d) al unui vehicul: %d. Nu pot sta amândoi acolo."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "NPC-uri: %d, dar config.json permite %d jucători și fiecare NPC ocupă un slot de jucător."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "Apeluri RemoveBuildingForPlayer: %d, peste limita SA-MP de %d per jucător: restul rămân în lume."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "Apeluri RemoveBuildingForPlayer: %d, dintre care %d pentru zone întregi (model -1) și %d pentru clădiri singure."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "Linii RemoveBuildingForPlayer care nu corespund unei clădiri GTA în acel loc: %d."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"Elemente SA-MP: %d, vehicule: %d\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d adăugate, %d șterse, %d mutate, %d rotite, %d material"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "Obiecte atașate sau referite excluse din curățare: %d."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "Fluxuri audio: %d. Un jucător aude doar unul odată, ultimul pornit."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "Apeluri omise: %d, deoarece poziția, modelul sau handle-ul nu este o valoare simplă (de exemplu o formulă sau o variabilă care conține coordonate)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "Obiecte din lume modificate: %d. Vor fi eliminate per jucător cu RemoveBuildingForPlayer și recreate de codul Pawn exportat dacă nu sunt șterse."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "Checkpoint-uri: %d, race checkpoint-uri: %d. Un jucător vede câte unul din fiecare odată, deci streamer-ul îl arată pe cel mai apropiat."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "Checkpoint-uri nescrise în cod nativ: %d (un jucător are un singur checkpoint odată, setat de script). Salvează ca cod Streamer."

msgid "%d corner(s)"
msgstr "Colțuri: %d"

msgid "%d days ago"
msgstr "Zile în urmă: %d"

msgid "%d duplicates in %d groups"
msgstr "Dubluri: %d, grupuri: %d"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "Zone dinamice nescrise în cod nativ: %d (aparțin streamer-ului). Salvează ca cod Streamer."

msgid "%d element(s) are in another virtual world or interior"
msgstr "Elemente în altă lume virtuală sau alt interior: %d"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "Elemente dincolo de harta San Andreas (±%d): %d. Funcționează, dar apa, harta și radarul jocului se termină acolo."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "Elemente în afara limitelor lumii SA-MP (±%d): %d. Serverul limitează sau ignoră acele poziții."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "Elemente cu modele personalizate: %d. Serverul le cere în models/artconfig.txt (sau AddSimpleModel) și cu artwork activat%s; jucătorii au nevoie de SA-MP 0.3.DL sau un client open.mp.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d elemente au același nume de variabilă „%s”: codul Pawn nu se va compila."

msgid "%d errors"
msgstr "Erori: %d"

msgid "%d favourites"
msgstr "Favorite: %d"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "Gang zone-uri pentru toți jucătorii: %d (%d per jucător, %d globale), peste cele %d pe care le poate avea un jucător; cele în plus nu sunt afișate."

msgid "%d global textdraws, over the limit of %d."
msgstr "Textdraw-uri globale: %d, peste limita de %d."

msgid "%d hidden"
msgstr "Ascunse: %d"

msgid "%d in"
msgstr "%d în cameră"

msgid "%d in map"
msgstr "În hartă: %d"

msgid "%d in the map (read-only)"
msgstr "În hartă: %d (doar citire)"

msgid "%d in, you'd be a %s"
msgstr "%d în cameră, ai fi %s"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "Elemente setate să apară doar într-o zonă dinamică: %d, dar codul nativ le arată peste tot. Salvează ca cod Streamer."

msgid "%d item(s) only inside it"
msgstr "Elemente doar în ea: %d"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "Elemente care apar doar într-o zonă dinamică din afara camerei: %d"

msgid "%d item(s) shown only inside it"
msgstr "Elemente afișate doar în ea: %d"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "Linii de material, atașament sau interior care se refereau la obiecte omise: %d."

msgid "%d models | %d instances"
msgstr "Modele: %d | instanțe: %d"

msgid "%d ms"
msgstr "%d ms"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "Obiecte care explodează când sunt lovite sau împușcate (object.dat), precum butoaiele și pompele de benzină: %d. Fiecare jucător le poate arunca în aer pe ecranul său."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d obiecte folosesc modele pe care editorul nu le are (%s). Modelele din alte moduri nu sunt disponibile."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d obiecte folosesc fontul „%s”, neinstalat aici: previzualizarea folosește %s. Jucătorii îl văd doar dacă au fontul. Pentru a-l previzualiza, pune .ttf-ul în folderul fonts (Informații obiect, Deschide folderul fonts) și rescanează."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "Obiecte cu modele necunoscute editorului omise la deschiderea hărții: %d. Salvarea le elimină.%s%s%s%s"

msgid "%d objects"
msgstr "Obiecte: %d"

msgid "%d objects along this path"
msgstr "Obiecte de-a lungul acestui traseu: %d"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "Obiecte vizibile: %d / create: %d (nativ, limită 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "Obiecte vizibile: %d / în stream: %d (din %d în raza de stream, limită 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d obiecte într-o rază de %.0f m dintr-un punct: un client 0.3.7 arată cel mult %d odată, deci streamer-ul va omite unele acolo."

msgid "%d objects, %d x %d cells"
msgstr "Obiecte: %d, celule: %d x %d"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "Obiecte: %d, celule: %d x %d (unele fără amprentă)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "Obiecte: %d, dar CreateObject se oprește la %d (%s). Obiectele peste limită nu sunt create; salvează cu cod Streamer."

msgid "%d of %d"
msgstr "%d din %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "Obiecte: %d din %d (%s): restul gamemode-ului are puțin spațiu rămas."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "Modele importate în folderul modloader/Haumea al jocului, pe care jucătorii SA-MP nu îl au: %d. Pot deveni modele personalizate în folderul models al serverului (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "Gang zone-uri per jucător sau streamed: %d. CreatePlayerGangZone se compilează și rulează doar pe open.mp, nu pe un server SA-MP 0.3.7. Pentru 0.3.7, setează-le ca Global (Informații obiect > Afișat ca, sau Afișat ca din radar art)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "Curse jucabile: %d. Au nevoie de haumea_races.inc, care nu este în includes din workspace: fără el harta se compilează, dar nu are curse. Setările unui race checkpoint îl pot salva acolo."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "Textdraw-uri de jucător: %d, peste limita de %d per jucător."

msgid "%d points"
msgstr "Puncte: %d"

msgid "%d selected"
msgstr "Selectate: %d"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "Obiecte din lume selectate care vor fi înlocuite în hartă: %d."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "Selectate: %d · Trage gizmo-ul pentru a muta sau roti · %s șterge."

msgid "%d selected, %d of this kind"
msgstr "Selectate: %d, de acest fel: %d"

msgid "%d selected: changes go to all of them."
msgstr "Selectate: %d. Modificările se aplică tuturor."

msgid "%d shown"
msgstr "Afișate: %d"

msgid "%d shown, GTA buildings removed: %d"
msgstr "Afișate: %d, clădiri GTA eliminate: %d"

msgid "%d similar models"
msgstr "Modele similare: %d"

msgid "%d skins"
msgstr "Skin-uri: %d"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "Texte cu diacritice sau simboluri salvate ca UTF-8: %d, dar clienții SA-MP și open.mp desenează Windows-1252, deci apar deformate („Ã§” în loc de „ç”). Salvează ca > Windows-1252 rezolvă problema."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "Textdraw-uri încă în hartă, doar citire: %d. TextDraws > Mută într-un fișier separat pentru a le edita."

msgid "%d textdraws"
msgstr "Textdraw-uri: %d"

msgid "%d texture(s)"
msgstr "Texturi: %d"

msgid "%d trailing bytes ignored"
msgstr "Octeți finali ignorați: %d"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "Copaci sau palmieri înclinați pe X sau Y: %d. Jocul îi leagănă în vânt și îi ridică drept, deci înclinarea nu se vede în joc."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "ID-uri de vehicul: %d (din care %d pentru trenuri, câte 4), peste limita de %d."

msgid "%d vehicles"
msgstr "Vehicule: %d"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "Vehicule: %d, actori în stream: %d  |  lume virtuală %d, interior %d"

msgid "%d vehicles, over the limit of %d."
msgstr "Vehicule: %d, peste limita de %d."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "Clădiri din lume afișate aici care sunt într-o eliminare cu model -1: %d. În joc rămân eliminate."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "Obiecte din lume din acest domeniu de export, nemodificate: %d. Vor fi omise. Mută, rotește, editează sau șterge unul dacă trebuie să devină o modificare Pawn."

msgid "%d x %d pixels"
msgstr "%d x %d px"

msgid "%d x %d texture, as SA-MP renders it"
msgstr "Textură %d x %d, așa cum o randează SA-MP"

msgid "%d zones"
msgstr "Zone: %d"

msgid "%d zones, at most %d around a player"
msgstr "Zone: %d, cel mult %d în jurul unui jucător"

msgid ""
"%s\n"
"\n"
"Or in ~/.codex/config.toml:\n"
"%s"
msgstr ""
"%s\n"
"\n"
"Sau în ~/.codex/config.toml:\n"
"%s"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Instanțe: %d, elemente SA-MP: %d, vehicule: %d\n"
"%s\n"
"Dublu clic pentru a plasa"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"Tags: %s\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Instanțe: %d, elemente SA-MP: %d, vehicule: %d\n"
"Etichete: %s\n"
"%s\n"
"Dublu clic pentru a plasa"

msgid ""
"%s\n"
"Double-click to open it."
msgstr ""
"%s\n"
"Dublu clic pentru a-l deschide."

msgid ""
"%s\n"
"Include it in your gamemode and call %s_CreateTextDraws()\n"
"from OnGameModeInit and %s_ShowTextDraws(playerid)."
msgstr ""
"%s\n"
"Include-l în gamemode și apelează %s_CreateTextDraws()\n"
"din OnGameModeInit și %s_ShowTextDraws(playerid)."

msgid ""
"%s\n"
"Native code, %s text"
msgstr ""
"%s\n"
"Cod nativ, text %s"

msgid ""
"%s\n"
"Streamer code, %s text"
msgstr ""
"%s\n"
"Cod Streamer, text %s"

msgid ""
"%s\n"
"TXD %s, model %d\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, model %d\n"
"Clic îl aplică; clic dreapta îl păstrează în Favorite."

msgid ""
"%s\n"
"TXD %s, model %d (no model loads this TXD)\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, model %d (niciun model nu încarcă acest TXD)\n"
"Clic îl aplică; clic dreapta îl păstrează în Favorite."

msgid "%s  (%d points)"
msgstr "%s  (puncte: %d)"

msgid "%s  model %d"
msgstr "%s  model %d"

msgid "%s (missing)"
msgstr "%s (lipsă)"

msgid "%s (you)"
msgstr "%s (tu)"

msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Explorare · %s Obiectele hărții · %s Salvează · %s Scurtături"

msgid "%s The update installs the next time Haumea starts."
msgstr "%s Actualizarea se instalează la următoarea pornire a Haumea."

msgid "%s already sits there."
msgstr "%s se află deja acolo."

msgid "%s already uses this name."
msgstr "%s folosește deja acest nume."

msgid "%s drops the selected objects onto the ground."
msgstr "%s lasă obiectele selectate pe sol."

msgid "%s exists: it is used as it is."
msgstr "%s există: este folosit ca atare."

msgid "%s follows path \"%s\", which has no points."
msgstr "%s urmează traseul „%s”, care nu are puncte."

msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s urmează traseul „%s”, care are un singur punct: merge acolo și se oprește."

msgid "%s has no text."
msgstr "%s nu are text."

msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s este la %.0f m de șină: în joc stă pe cea mai apropiată șină, la %.1f, %.1f, %.1f."

msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s este la limita de %d caractere și este posibil să fi fost tăiat."

msgid "%s is attached to a target that can't be used by Pawn."
msgstr "%s este atașat la o țintă care nu poate fi folosită de Pawn."

msgid "%s is attached to an object that was deleted."
msgstr "%s este atașat la un obiect care a fost șters."

msgid "%s is loading another map for everyone..."
msgstr "%s încarcă o altă hartă pentru toți..."

msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
msgstr "%s este setat să apară doar în zona „%s”, care nu este în hartă: este scris fără ea și apare peste tot."

msgid "%s isn't next to the editor. It ships with every release, and is in the source at https://github.com/itsneufox/Haumea-Studio."
msgstr "%s nu este lângă editor. Vine cu fiecare versiune și se află în codul sursă la https://github.com/itsneufox/Haumea-Studio."

msgid "%s joined the session"
msgstr "%s s-a alăturat sesiunii"

msgid "%s left the session"
msgstr "%s a părăsit sesiunea"

msgid "%s lists every keyboard shortcut; change them in Preferences."
msgstr "%s listează toate scurtăturile de tastatură; schimbă-le în Preferințe."

msgid "%s moves 0 m and doesn't turn, so its MoveObject does nothing."
msgstr "%s se mișcă 0 m și nu se rotește, deci MoveObject nu face nimic."

msgid "%s only shows inside area \"%s\", but they are in different virtual worlds or interiors: no player is ever in both."
msgstr "%s apare doar în zona „%s”, dar sunt în lumi virtuale sau interioare diferite: niciun jucător nu e vreodată în ambele."

msgid "%s pastes objects exactly where they were copied."
msgstr "%s lipește obiectele exact unde au fost copiate."

msgid "%s plays %s / %s, which moves only an object's parts: the skin stands still."
msgstr "%s rulează %s / %s, care mișcă doar părțile unui obiect: skin-ul rămâne nemișcat."

msgid "%s plays %s / %s, which twists the skin out of shape."
msgstr "%s rulează %s / %s, care deformează skin-ul."

msgid "%s plays driver recording %s but isn't driving a vehicle: open.mp reports it playing, yet the NPC never moves. Put it in a vehicle as the driver."
msgstr "%s rulează înregistrarea de șofer %s, dar nu conduce un vehicul: open.mp o raportează ca rulând, dar NPC-ul nu se mișcă niciodată. Pune-l într-un vehicul ca șofer."

msgid "%s plays on-foot recording %s while in a vehicle; it needs to be on foot."
msgstr "%s rulează înregistrarea pe jos %s într-un vehicul; trebuie să fie pe jos."

msgid "%s points the camera at the selection."
msgstr "%s îndreaptă camera spre selecție."

msgid "%s shares player attachment slot %d with %s."
msgstr "%s împarte slotul de atașament de jucător %d cu %s."

msgid "%s sits in a vehicle that was deleted, so it is saved on foot."
msgstr "%s stă într-un vehicul care a fost șters, deci este salvat pe jos."

msgid "%s uses a player bone attachment, but its target isn't a player or NPC."
msgstr "%s folosește un atașament la osul unui jucător, dar ținta sa nu este un jucător sau NPC."

