# Haumea Studio, Polski (pl).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Polski\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Kliknij prawym, aby zachować w Ulubionych"

msgid "  (in the map, read-only)"
msgstr "  (w mapie, tylko do odczytu)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (brak config.json w workspace do sprawdzenia max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Klienci 0.3.7 są dozwoleni, ale ich nie zobaczą."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " Własne ID spoza artconfig.txt lub AddSimpleModel: "

msgid " IDs: "
msgstr " ID: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\" nie ma w TXD \"%s\" (ani w jego rodzicach); zostaje oryginalna tekstura."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\" nie ma w TXD modelu niestandardowego %d; zostaje oryginalna tekstura."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" nie jest tu zainstalowana. Ta darmowa czcionka ma te same szerokości liter,\n"
"dzięki czemu tekst mieści się jak w grze; kształty liter różnią się nieco."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" nie jest tu zainstalowana; podgląd używa %s. Gracze bez niej dostaną zastępczą czcionkę Windows."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" nie jest nazwą zmiennej Pawn"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f°)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID modelu %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  nadpisania materiałów"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "%.2f m in %.2f s"
msgstr "%.2f m w %.2f s"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f jedn. | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Kliknij dwukrotnie, aby umieścić"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  instancje: %d"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, ponad limit serwera (%d); nadmiarowe nie są tworzone."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "NPC w pętli lub chodzące tam i z powrotem po swojej ścieżce: %d. Wywołaj <prefix>_OnNPCFinishMovePath(npcid, pathid) mapy z OnNPCFinishMovePath w swoim gamemodzie, inaczej zatrzymają się na końcu ścieżki."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "Liczba NPC: %d, zajmą slotów graczy: %d%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "NPC: %d, nazwa \"%s\": nazwy muszą być unikalne, więc powstanie tylko jeden."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "NPC siedzą na tym samym miejscu jednego pojazdu: %d (miejsce %d). Nie mogą siedzieć tam razem."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "NPC: %d, ale config.json pozwala na %d graczy, a każdy NPC zajmuje slot gracza."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "Wywołania RemoveBuildingForPlayer: %d, ponad limit SA-MP (%d na gracza): reszta zostaje w świecie."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "Wywołania RemoveBuildingForPlayer: %d, w tym %d dla całych obszarów (model -1) i %d dla pojedynczych budynków."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "Linie RemoveBuildingForPlayer bez dopasowanego budynku GTA w tym miejscu: %d."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"Elementy SA-MP: %d, pojazdy: %d\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "dodano: %d, usunięto: %d, przesunięto: %d, obrócono: %d, materiał: %d"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "Obiekty dołączone lub wskazywane, wykluczone z czyszczenia: %d."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "Strumienie audio: %d. Gracz słyszy jeden naraz, ostatnio uruchomiony."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "Pominięte wywołania: %d, ponieważ ich pozycja, model lub uchwyt nie jest zwykłą wartością (na przykład wzór lub zmienna ze współrzędnymi)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "Zmienione obiekty świata: %d. Zostaną usunięte dla każdego gracza przez RemoveBuildingForPlayer i odtworzone przez wyeksportowany kod Pawn, o ile nie zostaną usunięte."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "checkpoint: %d, race checkpoint: %d. Gracz widzi po jednym z każdego naraz, więc streamer pokazuje najbliższy."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "Checkpoint: %d nie jest zapisany w kodzie natywnym (gracz ma jeden checkpoint naraz, ustawiany przez skrypt). Zapisz jako kod Streamer."

msgid "%d corner(s)"
msgstr "Wierzchołki: %d"

msgid "%d days ago"
msgstr "%d dni temu"

msgid "%d duplicates in %d groups"
msgstr "Duplikaty: %d, grupy: %d"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "Obszary dynamiczne: %d nie są zapisane w kodzie natywnym (należą do streamera). Zapisz jako kod Streamer."

msgid "%d element(s) are in another virtual world or interior"
msgstr "Elementy w innym wirtualnym świecie lub wnętrzu: %d"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "Elementy poza mapą San Andreas: %d (±%d). Działają, ale woda, mapa i radar gry kończą się tam."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "Elementy poza granicami świata SA-MP: %d (±%d). Serwer przycina lub ignoruje te pozycje."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "Elementy z modelami niestandardowymi: %d. Serwer potrzebuje ich w models/artconfig.txt (lub AddSimpleModel) i włączonych artworków%s; gracze potrzebują SA-MP 0.3.DL lub klienta open.mp.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "Elementy: %d, wspólna nazwa zmiennej \"%s\": kod Pawn się nie skompiluje."

msgid "%d errors"
msgstr "Błędy: %d"

msgid "%d favourites"
msgstr "Ulubione: %d"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "Gang zones dla każdego gracza: %d (%d na gracza, %d globalnych), ponad limit %d na gracza; nadmiarowe nie są pokazywane."

msgid "%d global textdraws, over the limit of %d."
msgstr "Globalne textdraws: %d, ponad limit %d."

msgid "%d hidden"
msgstr "Ukryte: %d"

msgid "%d in"
msgstr "W pokoju: %d"

msgid "%d in map"
msgstr "Na mapie: %d"

msgid "%d in the map (read-only)"
msgstr "Na mapie: %d (tylko do odczytu)"

msgid "%d in, you'd be a %s"
msgstr "W pokoju: %d, twoja rola: %s"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "Elementy ustawione tak, by pokazywać się tylko w obszarze dynamicznym, ale kod natywny pokazuje je wszędzie: %d. Zapisz jako kod Streamer."

msgid "%d item(s) only inside it"
msgstr "Elementy tylko w tym obszarze: %d"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "Elementy widoczne tylko w obszarze dynamicznym, poza którym jest kamera: %d"

msgid "%d item(s) shown only inside it"
msgstr "Elementy widoczne tylko w nim: %d"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "Linie materiałów, załączników lub wnętrz odwołujące się do pominiętych obiektów: %d."

msgid "%d models | %d instances"
msgstr "Modele: %d | instancje: %d"

msgid "%d ms"
msgstr "%d ms"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "Obiekty wybuchające po strzale lub uderzeniu (object.dat), np. beczki i dystrybutory: %d. Każdy gracz może je wysadzić na własnym ekranie."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "Obiekty z modelami, których edytor nie ma: %d (%s). Modele z innych modów są niedostępne."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "Obiekty: %d, czcionka \"%s\" nie jest tu zainstalowana: podgląd używa %s. Gracze zobaczą ją tylko, jeśli ją mają. Aby ją podejrzeć, wrzuć jej .ttf do folderu fonts (Informacje o obiekcie, Otwórz folder czcionek) i przeskanuj ponownie."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "Obiekty z modelami nieznanymi edytorowi, pominięte przy otwieraniu mapy: %d. Zapis je odrzuci.%s%s%s%s"

msgid "%d objects"
msgstr "Obiekty: %d"

msgid "%d objects along this path"
msgstr "Obiekty wzdłuż tej ścieżki: %d"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "Widoczne obiekty: %d / utworzone: %d (natywnie, limit 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "Widoczne obiekty: %d / streamowane: %d (z %d w zasięgu streamu, limit 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "Obiekty: %d w promieniu %.0f m od jednego punktu. Klient 0.3.7 pokazuje naraz najwyżej %d, więc streamer część tam pominie."

msgid "%d objects, %d x %d cells"
msgstr "Obiekty: %d, siatka %d x %d"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "Obiekty: %d, siatka %d x %d (część bez śladu)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "Obiekty: %d, ale CreateObject kończy się na %d (%s). Obiekty ponad limit nie są tworzone; zapisz zamiast tego jako kod Streamer."

msgid "%d of %d"
msgstr "%d z %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "Obiekty: %d z %d (%s): w reszcie gamemode zostaje mało miejsca."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "Modele zaimportowane do folderu modloader/Haumea gry: %d. Gracze SA-MP go nie mają. Mogą zostać modelami niestandardowymi w folderze models serwera (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "Gang zones na gracza lub streamowane: %d. CreatePlayerGangZone kompiluje się i działa tylko na open.mp, nie na serwerze SA-MP 0.3.7. Dla 0.3.7 ustaw je jako Global (Informacje o obiekcie > Pokazane jako, lub Pokazane jako w radar art)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "Wyścigi do rozegrania: %d. Potrzebują haumea_races.inc, którego nie ma w includes workspace: bez niego mapa się kompiluje, ale nie ma wyścigów. Ustawienia race checkpoint mogą zapisać go tam."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "Player textdraws: %d, ponad limit %d na gracza."

msgid "%d points"
msgstr "Punkty: %d"

msgid "%d selected"
msgstr "Zaznaczone: %d"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "Zaznaczone obiekty świata do zastąpienia w mapie: %d."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "Zaznaczone: %d · Przeciągnij gizmo, aby przesunąć lub obrócić · %s usuwa."

msgid "%d selected, %d of this kind"
msgstr "Zaznaczone: %d, tego rodzaju: %d"

msgid "%d selected: changes go to all of them."
msgstr "Zaznaczone: %d. Zmiany dotyczą wszystkich."

msgid "%d shown"
msgstr "Pokazane: %d"

msgid "%d shown, GTA buildings removed: %d"
msgstr "Pokazane: %d, usunięte budynki GTA: %d"

msgid "%d similar models"
msgstr "Podobne modele: %d"

msgid "%d skins"
msgstr "Skiny: %d"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "Teksty z akcentami lub symbolami zapisane jako UTF-8: %d. Klienci SA-MP i open.mp rysują Windows-1252, więc wyglądają na zepsute (\"Ã§\" zamiast \"ç\"). Naprawia to Zapisz jako > Windows-1252."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "TextDraws nadal w mapie, tylko do odczytu: %d. TextDraws > Przenieś do osobnego pliku, aby je edytować."

msgid "%d textdraws"
msgstr "TextDraws: %d"

msgid "%d texture(s)"
msgstr "Tekstury: %d"

msgid "%d trailing bytes ignored"
msgstr "Zignorowane bajty końcowe: %d"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "Drzewa lub palmy pochylone w X lub Y: %d. Gra kołysze je na wietrze i prostuje, więc pochylenie nie jest widoczne w grze."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "ID pojazdów: %d (w tym %d dla pociągów, po 4), ponad limit %d."

msgid "%d vehicles"
msgstr "Pojazdy: %d"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "Pojazdy: %d, aktorzy streamowani: %d  |  wirtualny świat %d, wnętrze %d"

msgid "%d vehicles, over the limit of %d."
msgstr "Pojazdy: %d, ponad limit %d."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "Budynki świata widoczne tutaj w obrębie usunięcia modelu -1: %d. W grze pozostają usunięte."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "Obiekty świata w tym zakresie eksportu bez zmian: %d. Zostaną pominięte. Przesuń, obróć, edytuj lub usuń jeden, aby stał się zmianą Pawn."

msgid "%d x %d pixels"
msgstr "%d x %d px"

msgid "%d x %d texture, as SA-MP renders it"
msgstr "Tekstura %d x %d, tak jak renderuje ją SA-MP"

msgid "%d zones"
msgstr "Strefy: %d"

msgid "%d zones, at most %d around a player"
msgstr "Strefy: %d, najwyżej %d wokół gracza"

msgid ""
"%s\n"
"\n"
"Or in ~/.codex/config.toml:\n"
"%s"
msgstr ""
"%s\n"
"\n"
"Lub w ~/.codex/config.toml:\n"
"%s"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Instancje: %d, elementy SA-MP: %d, pojazdy: %d\n"
"%s\n"
"Kliknij dwukrotnie, aby umieścić"

msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"Tags: %s\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"Instancje: %d, elementy SA-MP: %d, pojazdy: %d\n"
"Tagi: %s\n"
"%s\n"
"Kliknij dwukrotnie, aby umieścić"

msgid ""
"%s\n"
"Double-click to open it."
msgstr ""
"%s\n"
"Kliknij dwukrotnie, aby otworzyć."

msgid ""
"%s\n"
"Include it in your gamemode and call %s_CreateTextDraws()\n"
"from OnGameModeInit and %s_ShowTextDraws(playerid)."
msgstr ""
"%s\n"
"Dołącz go do gamemode i wywołaj %s_CreateTextDraws()\n"
"z OnGameModeInit oraz %s_ShowTextDraws(playerid)."

msgid ""
"%s\n"
"Native code, %s text"
msgstr ""
"%s\n"
"Kod natywny, kodowanie tekstu %s"

msgid ""
"%s\n"
"Streamer code, %s text"
msgstr ""
"%s\n"
"Kod Streamer, kodowanie tekstu %s"

msgid ""
"%s\n"
"TXD %s, model %d\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, model %d\n"
"Kliknięcie stosuje go; prawy przycisk zachowuje w Ulubionych."

msgid ""
"%s\n"
"TXD %s, model %d (no model loads this TXD)\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s, model %d (żaden model nie ładuje tego TXD)\n"
"Kliknięcie stosuje go; prawy przycisk zachowuje w Ulubionych."

msgid "%s  (%d points)"
msgstr "%s  (punkty: %d)"

msgid "%s  model %d"
msgstr "%s  model %d"

msgid "%s (missing)"
msgstr "%s (brak)"

msgid "%s (you)"
msgstr "%s (ty)"

msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Przeglądaj · %s Obiekty mapy · %s Zapisz · %s Skróty"

msgid "%s The update installs the next time Haumea starts."
msgstr "%s Aktualizacja zainstaluje się przy następnym uruchomieniu Haumea."

msgid "%s already sits there."
msgstr "%s już tam siedzi."

msgid "%s already uses this name."
msgstr "%s już używa tej nazwy."

msgid "%s drops the selected objects onto the ground."
msgstr "%s upuszcza zaznaczone obiekty na ziemię."

msgid "%s exists: it is used as it is."
msgstr "%s istnieje: jest używany bez zmian."

msgid "%s follows path \"%s\", which has no points."
msgstr "%s podąża ścieżką \"%s\", która nie ma punktów."

msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s podąża ścieżką \"%s\", która ma jeden punkt: dojdzie tam i się zatrzyma."

msgid "%s has no text."
msgstr "%s nie ma tekstu."

msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s jest %.0f m od toru: w grze stoi na najbliższym torze, w %.1f, %.1f, %.1f."

msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s osiąga limit %d znaków i mógł zostać ucięty."

msgid "%s is attached to a target that can't be used by Pawn."
msgstr "%s jest dołączony do celu, którego Pawn nie może użyć."

msgid "%s is attached to an object that was deleted."
msgstr "%s jest dołączony do usuniętego obiektu."

msgid "%s is loading another map for everyone..."
msgstr "%s ładuje inną mapę dla wszystkich..."

msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
msgstr "%s pokazuje się tylko w obszarze \"%s\", którego nie ma w mapie: jest zapisany bez niego i pokazuje się wszędzie."

msgid "%s isn't next to the editor. It ships with every release, and is in the source at https://github.com/itsneufox/Haumea-Studio."
msgstr "%s nie leży obok edytora. Jest dołączany do każdego wydania i znajduje się w kodzie źródłowym pod https://github.com/itsneufox/Haumea-Studio."

msgid "%s joined the session"
msgstr "%s dołączył(a) do sesji"

msgid "%s left the session"
msgstr "%s opuścił(a) sesję"

msgid "%s lists every keyboard shortcut; change them in Preferences."
msgstr "%s pokazuje wszystkie skróty klawiszowe; zmienisz je w Ustawieniach."

msgid "%s moves 0 m and doesn't turn, so its MoveObject does nothing."
msgstr "%s porusza się o 0 m i nie obraca, więc jego MoveObject nic nie robi."

msgid "%s only shows inside area \"%s\", but they are in different virtual worlds or interiors: no player is ever in both."
msgstr "%s pokazuje się tylko w obszarze \"%s\", ale są w różnych wirtualnych światach lub wnętrzach: żaden gracz nie jest w obu naraz."

msgid "%s pastes objects exactly where they were copied."
msgstr "%s wkleja obiekty dokładnie tam, gdzie je skopiowano."

msgid "%s plays %s / %s, which moves only an object's parts: the skin stands still."
msgstr "%s odtwarza %s / %s, co rusza tylko częściami obiektu: skin stoi w miejscu."

msgid "%s plays %s / %s, which twists the skin out of shape."
msgstr "%s odtwarza %s / %s, co zniekształca skin."

msgid "%s plays driver recording %s but isn't driving a vehicle: open.mp reports it playing, yet the NPC never moves. Put it in a vehicle as the driver."
msgstr "%s odtwarza nagranie kierowcy %s, ale nie prowadzi pojazdu: open.mp zgłasza odtwarzanie, lecz NPC się nie rusza. Posadź go w pojeździe jako kierowcę."

