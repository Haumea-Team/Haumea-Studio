# Haumea Studio, Bahasa Indonesia (id).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: Bahasa Indonesia\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Klik kanan untuk simpan di Favorit"

msgid "  (in the map, read-only)"
msgstr "  (di peta, hanya baca)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (tidak ada config.json di workspace untuk memeriksa max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Klien 0.3.7 tetap diizinkan dan tidak akan melihatnya."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " ID kustom yang tidak ada di artconfig.txt atau AddSimpleModel: "

msgid " IDs: "
msgstr " ID: "

msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\" tidak ada di TXD \"%s\" (atau induknya); tekstur asli tetap dipakai."

msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\" tidak ada di TXD model kustom %d; tekstur asli tetap dipakai."

msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" tidak terpasang di sini. Font gratis ini punya lebar huruf yang sama,\n"
"jadi teks pas seperti di game; bentuk hurufnya sedikit berbeda."

msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" tidak terpasang di sini; pratinjau memakai %s. Pemain tanpa font ini akan mendapat font pengganti Windows."

msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" bukan nama variabel Pawn"

msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"

msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID model %d -> %d"

msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  override material"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "%.2f m in %.2f s"
msgstr "%.2f m dalam %.2f s"

msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f unit | dX %.3f  dY %.3f  dZ %.3f"

msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Klik dua kali untuk menaruh"

msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  %d instans"

msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, melebihi batas server %d; sisanya tidak dibuat."

msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "%d NPC berputar atau berjalan bolak-balik di jalurnya: panggil <prefix>_OnNPCFinishMovePath(npcid, pathid) milik peta dari OnNPCFinishMovePath di gamemode Anda, atau mereka berhenti di ujung jalur."

msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "%d NPC akan memakai %d slot pemain%s."

msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d NPC bernama \"%s\": nama harus unik, jadi hanya satu yang dibuat."

msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "%d NPC duduk di kursi yang sama (%d) pada satu kendaraan: mereka tidak bisa duduk bersamaan."

msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "%d NPC, tetapi config.json hanya mengizinkan %d pemain dan setiap NPC memakai satu slot pemain."

msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "%d panggilan RemoveBuildingForPlayer, melebihi batas SA-MP %d per pemain: sisanya tetap ada di dunia."

msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "%d panggilan RemoveBuildingForPlayer: %d untuk seluruh area (model -1) dan %d untuk bangunan tunggal."

msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "%d baris RemoveBuildingForPlayer tidak cocok dengan bangunan GTA di lokasi itu."

msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"%d elemen SA-MP, %d kendaraan\n"
"%s"

msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d ditambah, %d dihapus, %d dipindah, %d diputar, %d material"

msgid "%d attached or referenced objects excluded from cleanup."
msgstr "%d objek terpasang atau direferensikan dikecualikan dari pembersihan."

msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "%d aliran audio: pemain hanya mendengar satu per satu, yang terakhir dimulai."

msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "%d panggilan dilewati karena posisi, model, atau handle-nya bukan nilai biasa (misalnya rumus atau variabel yang berisi koordinat)."

msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "%d objek dunia yang diubah akan dihapus per pemain dengan RemoveBuildingForPlayer dan dibuat ulang oleh kode Pawn hasil ekspor jika tidak dihapus."

msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "%d checkpoint dan %d race checkpoint: pemain melihat masing-masing satu pada satu waktu, jadi streamer menampilkan yang terdekat."

msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "%d checkpoint tidak ditulis dalam kode native (pemain hanya punya satu checkpoint pada satu waktu, diatur oleh skrip). Simpan sebagai kode Streamer."

msgid "%d corner(s)"
msgstr "%d sudut"

msgid "%d days ago"
msgstr "%d hari lalu"

msgid "%d duplicates in %d groups"
msgstr "%d duplikat dalam %d grup"

msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "%d area dinamis tidak ditulis dalam kode native (itu milik streamer). Simpan sebagai kode Streamer."

msgid "%d element(s) are in another virtual world or interior"
msgstr "%d elemen berada di virtual world atau interior lain"

msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "%d elemen di luar peta San Andreas (±%d). Tetap berfungsi, tetapi air, peta, dan radar game berakhir di sana."

msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "%d elemen di luar batas dunia SA-MP (±%d): server membatasi atau mengabaikan posisi itu."

msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "%d elemen memakai model kustom: server memerlukannya di models/artconfig.txt (atau AddSimpleModel) dan artwork aktif%s; pemain memerlukan SA-MP 0.3.DL atau klien open.mp.%s"

msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d elemen memakai nama variabel \"%s\" yang sama: kode Pawn tidak akan dikompilasi."

msgid "%d errors"
msgstr "%d error"

msgid "%d favourites"
msgstr "%d favorit"

msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "%d gang zone untuk setiap pemain (%d per pemain, %d global), melebihi batas %d per pemain; sisanya tidak ditampilkan."

msgid "%d global textdraws, over the limit of %d."
msgstr "%d textdraw global, melebihi batas %d."

msgid "%d hidden"
msgstr "%d tersembunyi"

msgid "%d in"
msgstr "%d di dalam"

msgid "%d in map"
msgstr "%d di peta"

msgid "%d in the map (read-only)"
msgstr "%d di peta (hanya baca)"

msgid "%d in, you'd be a %s"
msgstr "%d di dalam, Anda akan menjadi %s"

msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "%d item diatur tampil hanya di dalam area dinamis, tetapi kode native menampilkannya di mana-mana. Simpan sebagai kode Streamer."

msgid "%d item(s) only inside it"
msgstr "%d item hanya di dalamnya"

msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "%d item hanya tampil di dalam area dinamis yang berada di luar jangkauan kamera"

msgid "%d item(s) shown only inside it"
msgstr "%d item tampil hanya di dalamnya"

msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "%d baris material, attachment, atau interior merujuk ke objek yang dilewati."

msgid "%d models | %d instances"
msgstr "%d model | %d instans"

msgid "%d ms"
msgstr "%d ms"

msgid "%d object(s) explode when shot or hit (object.dat), such as barrels and petrol pumps. Each player can blow them up on their own screen."
msgstr "%d objek meledak saat ditembak atau dihantam (object.dat), seperti tong dan pompa bensin. Setiap pemain bisa meledakkannya di layarnya sendiri."

msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d objek memakai model yang tidak dimiliki editor (%s). Model dari mod lain tidak tersedia."

msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d objek memakai font \"%s\" yang tidak terpasang di sini: pratinjau memakai %s. Pemain hanya melihatnya jika punya font tersebut. Untuk pratinjau, taruh .ttf-nya di folder fonts (Info objek, Buka folder fonts) lalu pindai ulang."

msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "%d objek dengan model yang tidak dikenal editor dilewati saat peta dibuka, dan menyimpan akan membuangnya.%s%s%s%s"

msgid "%d objects"
msgstr "%d objek"

msgid "%d objects along this path"
msgstr "%d objek di sepanjang jalur ini"

msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "%d objek terlihat / %d dibuat (native, batas 1000)"

msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "%d objek terlihat / %d di-stream (dari %d dalam jangkauan stream, batas 1000)"

msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d objek dalam radius %.0f m dari satu titik: klien 0.3.7 menampilkan paling banyak %d sekaligus, jadi streamer akan melewatkan sebagian di sana."

msgid "%d objects, %d x %d cells"
msgstr "%d objek, %d x %d sel"

msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "%d objek, %d x %d sel (sebagian tanpa jejak)"

msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "%d objek, tetapi CreateObject berhenti di %d (%s). Objek di luar batas tidak dibuat; simpan dengan kode Streamer."

msgid "%d of %d"
msgstr "%d dari %d"

msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "%d dari %d objek (%s): sisa gamemode hanya punya sedikit ruang."

msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "%d dari model itu diimpor ke folder modloader/Haumea game, yang tidak dimiliki pemain SA-MP. Model tersebut bisa menjadi model kustom di folder models server (SA-MP 0.3.DL / open.mp)."

msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "%d gang zone per pemain atau streamed: CreatePlayerGangZone hanya dikompilasi dan berjalan di open.mp, bukan di server SA-MP 0.3.7. Untuk 0.3.7, atur ke Global (Info objek > Ditampilkan sebagai, atau Ditampilkan sebagai di radar art)."

msgid "%d playable race(s) need haumea_races.inc, which isn't in the workspace's includes: without it the map compiles but has no races. A race checkpoint's settings can save it there."
msgstr "%d balapan yang bisa dimainkan memerlukan haumea_races.inc, yang tidak ada di includes workspace: tanpanya peta tetap dikompilasi tetapi tidak punya balapan. Pengaturan race checkpoint bisa menyimpannya di sana."

msgid "%d player textdraws, over the limit of %d per player."
msgstr "%d textdraw pemain, melebihi batas %d per pemain."

msgid "%d points"
msgstr "%d titik"

msgid "%d selected"
msgstr "%d dipilih"

msgid "%d selected world object(s) will be replaced in the map."
msgstr "%d objek dunia terpilih akan diganti di peta."

msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "%d dipilih · Seret gizmo untuk memindah atau memutar · %s menghapus."

msgid "%d selected, %d of this kind"
msgstr "%d dipilih, %d dari jenis ini"

msgid "%d selected: changes go to all of them."
msgstr "%d dipilih: perubahan berlaku untuk semuanya."

msgid "%d shown"
msgstr "%d ditampilkan"

msgid "%d shown, GTA buildings removed: %d"
msgstr "%d ditampilkan, bangunan GTA dihapus: %d"

msgid "%d similar models"
msgstr "%d model serupa"

msgid "%d skins"
msgstr "%d skin"

msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "%d teks dengan aksen atau simbol disimpan sebagai UTF-8, tetapi klien SA-MP dan open.mp menggambar Windows-1252, jadi tampil rusak (\"Ã§\" untuk \"ç\"). Simpan Sebagai > Windows-1252 memperbaikinya."

msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "%d textdraw masih ada di peta, hanya baca: TextDraws > Pindahkan ke file terpisah untuk mengeditnya."

msgid "%d textdraws"
msgstr "%d textdraw"

msgid "%d texture(s)"
msgstr "%d tekstur"

msgid "%d trailing bytes ignored"
msgstr "%d byte sisa diabaikan"

msgid "%d tree(s) or palm(s) tilted on X or Y: the game sways them in the wind and stands them upright, so the tilt doesn't show in game."
msgstr "%d pohon atau palem miring di X atau Y: game menggoyangkannya oleh angin dan menegakkannya, jadi kemiringan tidak terlihat di game."

msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "%d ID kendaraan (%d di antaranya untuk kereta, masing-masing 4), melebihi batas %d."

msgid "%d vehicles"
msgstr "%d kendaraan"

msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "%d kendaraan, %d aktor di-stream  |  virtual world %d, interior %d"

msgid "%d vehicles, over the limit of %d."
msgstr "%d kendaraan, melebihi batas %d."

msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "%d bangunan dunia yang tampil di sini berada di dalam penghapusan model -1: di game tetap terhapus."

msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "%d objek dunia dalam cakupan ekspor ini tidak berubah dan akan dihilangkan. Pindahkan, putar, edit, atau hapus satu jika harus menjadi perubahan Pawn."

msgid "%d x %d pixels"
msgstr "%d x %d piksel"

msgid "%d x %d texture, as SA-MP renders it"
msgstr "Tekstur %d x %d, seperti dirender SA-MP"

msgid "%d zones"
msgstr "%d zona"

msgid "%d zones, at most %d around a player"
msgstr "%d zona, paling banyak %d di sekitar pemain"

